# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and provide your actual credentials.
# NEVER commit .env with real credentials, database passwords, or secret keys.
# ==============================================================================

# Database Connection (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:password@localhost:5432/house_system?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/house_system?schema=public"

# Supabase Project URL (Optional)
SUPABASE_URL="https://your-project.supabase.co"

# JWT Secret for Session Authentication
JWT_SECRET="replace-with-a-secure-random-secret-key"

# Application Metadata
NEXT_PUBLIC_APP_NAME="Angren Ixtisoslashtirilgan Maktabi - House System"

# Telegram Bot & Notification Broadcast (Optional, can also be configured in Admin Settings)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRstuv..."
TELEGRAM_BOT_USERNAME="YourSchoolHouseBot"
TELEGRAM_CHANNEL_ID="@angren_school_houses"
TELEGRAM_NOTIFICATIONS_ENABLED="true"
